# CivicEye Environment Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LOG_LEVEL=INFO

# Storage
DATA_DIR=data
MAX_UPLOAD_SIZE_MB=500

# Scoring Weights (Deterministic 0-100)
WEIGHT_WATER=0.35
WEIGHT_TRASH_INSIDE=0.25
WEIGHT_TRASH_NEAR=0.15
WEIGHT_INLET_BLOCKED=0.10
WEIGHT_HAZARD=0.10
WEIGHT_WET_CONDITIONS=0.05
SEWER_OVERFLOW_FLOOR=70

# Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_RECIPIENT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
